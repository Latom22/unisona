# Copy to .env for local dev (npm run dev loads it via --env-file in the README).
# On Fly, set secrets with:  fly secrets set KEY=value ...

SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Only for projects still on the legacy HS256 JWT secret; otherwise JWKS is used.
SUPABASE_JWT_SECRET=

DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3

ANTHROPIC_API_KEY=
TRANSLATION_MODEL=claude-opus-5-5
TRANSLATION_EFFORT=low

AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastus
AZURE_TTS_FORMAT=audio-24khz-48kbitrate-mono-mp3
# AZURE_TTS_VOICES={"es":"es-ES-ElviraNeural"}

STRIPE_SECRET_KEY=
STRIPE_METER_EVENT_NAME=unisona_speaking_seconds

SENTRY_DSN=

# Comma-separated list; unset = allow any origin
# ALLOWED_ORIGINS=https://app.unisona.com,https://listen.unisona.com
LOG_LEVEL=debug
